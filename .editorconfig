root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2

# Styles
[*.{css,scss}]
indent_size = 2

# Data files
[*.{json,yml,yaml}]
indent_size = 2

# Documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = 0

# Generated / Minified files
[*.{min.js,min.css,bundle.js}]
indent_style = ignore