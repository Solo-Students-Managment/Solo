{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/features/**/index.ts",
    "src/components/**/index.ts",
    "src/components/**/index.tsx",
    "src/lib/**/index.ts",
    "src/services/**/index.ts",
    "src/mocks/**/*.{ts,tsx}",
    "src/test/**/*.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
  "ignore": [
    "src/**/.gitkeep.ts",
    "src/components/**/.gitkeep.ts",
    "src/hooks/.gitkeep.ts",
    "src/schemas/.gitkeep.ts",
    "src/types/.gitkeep.ts",
    "src/constants/.gitkeep.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "eslint-config-next",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-plugin-unused-imports",
    "lint-staged",
    "@hookform/resolvers",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-dialog",
    "@radix-ui/react-dropdown-menu",
    "@radix-ui/react-select",
    "@radix-ui/react-separator",
    "@radix-ui/react-tabs",
    "@radix-ui/react-toast",
    "@radix-ui/react-tooltip",
    "@tanstack/react-table",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "react-hook-form",
    "recharts",
    "@t3-oss/env-nextjs",
    "@types/jalaali-js"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "files": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "unlisted": "off",
    "binaries": "off"
  }
}
